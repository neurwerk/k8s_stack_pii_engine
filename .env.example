# Safe local shape only. Do not place real credentials or private key material here.
PII_ENGINE_ANALYSIS_HOST=127.0.0.1
PII_ENGINE_ANALYSIS_PORT=8443
PII_ENGINE_MANAGEMENT_HOST=127.0.0.1
PII_ENGINE_MANAGEMENT_PORT=8001
PII_ENGINE_LOG_LEVEL=INFO

# Production policy and mTLS paths.
PII_ENGINE_POLICY_CONFIG=/path/to/non-secret-policy.yaml
PII_ENGINE_POLICY_VERSION=v1
PII_ENGINE_TLS_CERT=/path/to/server-certificate.pem
PII_ENGINE_TLS_KEY=/path/to/private-key.pem
PII_ENGINE_TLS_CA=/path/to/ca-certificate.pem
PII_ENGINE_ADAPTER_COMMON_NAME=monitor-agentgateway-extproc
PII_ENGINE_STUDIO_COMMON_NAME=frontend-studio-api
PII_ENGINE_ENFORCE_CLIENT_IDENTITY=true

# Runtime secrets. Replace redacted values only in a local untracked .env or
# secret manager. The encryption key must be exactly 32 bytes; the hash key must
# be at least 32 bytes.
PII_ENGINE_HASH_KEY=REDACTED_AT_LEAST_32_BYTE_SECRET
PII_ENGINE_ENCRYPTION_KEY=REDACTED_EXACTLY_32_BYTE_SECRETX
PII_ENGINE_VALKEY_URL=REDACTED_CREDENTIAL_BEARING_URL

# Optional verified transformer bundle selection. These pins are non-secret.
PII_ENGINE_DEVICE=cpu
PII_ENGINE_MODEL_CACHE_PATH=/path/to/model-cache
PII_ENGINE_MODEL_BUNDLE_REFERENCE=/path/to/model-cache/desired-bundle.json
PII_ENGINE_MODEL_BUNDLE_VERSION=REPLACE_WITH_IMMUTABLE_BUNDLE_VERSION
PII_ENGINE_MODEL_MANIFEST_SHA256=REPLACE_WITH_64_LOWERCASE_HEX_DIGEST

# The model-sync CLI obtains object-store credentials from boto3's standard
# provider chain (for example AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY). Keep
# those values out of this file and inject them through a secret manager.
